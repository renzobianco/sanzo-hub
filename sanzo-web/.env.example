# API key de Resend (https://resend.com/api-keys). Sin esto, el pedido se loguea en consola.
RESEND_API_KEY=
# Mail donde llegan los pedidos
PEDIDOS_EMAIL=
# Remitente (opcional). Tiene que ser de un dominio verificado en Resend.
# Si no lo ponés se usa onboarding@resend.dev (solo envía al mail de tu cuenta de Resend).
PEDIDOS_FROM=
# URL pública del sitio (opcional, para Open Graph). Ej: https://sanzo.com.ar
NEXT_PUBLIC_SITE_URL=
# Access Token de producción de Mercado Pago (Checkout Pro). Sin esto, no se cobra online.
MP_ACCESS_TOKEN=
# Gmail desde el que sale el mail de confirmación al cliente cuando se aprueba el pago.
GMAIL_USUARIO=sanzopets@gmail.com
# Contraseña de aplicación de Google (16 letras, https://myaccount.google.com/apppasswords). No es la clave del mail.
GMAIL_CLAVE_APP=
# Pixel de Meta (conjunto de datos). Público. Sin esto no se carga el Pixel ni se manda nada a Meta.
NEXT_PUBLIC_META_PIXEL_ID=27096330653398044
# Token de la API de Conversiones de Meta (Administrador de eventos → conjunto de datos → Configuración → Generar token). Secreto: solo en Vercel / .env.local.
META_CAPI_TOKEN=
# Opcional, solo para probar: código de "Probar eventos" del Administrador de eventos (ej. TEST12345). Con esto, todos los eventos del servidor van como prueba. Sacarlo al terminar.
META_TEST_EVENT_CODE=
