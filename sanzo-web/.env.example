# API key de Resend (https://resend.com/api-keys). Sin esto, el pedido se loguea en consola.
RESEND_API_KEY=
# Mail donde llegan los pedidos
PEDIDOS_EMAIL=
# Remitente (opcional). Tiene que ser de un dominio verificado en Resend.
# Si no lo ponés se usa onboarding@resend.dev (solo envía al mail de tu cuenta de Resend).
PEDIDOS_FROM=
# URL pública del sitio (opcional, para Open Graph). Ej: https://sanzo.com.ar
NEXT_PUBLIC_SITE_URL=
# Access Token de producción de Mercado Pago (Checkout Pro). Sin esto, no se cobra online.
MP_ACCESS_TOKEN=
